<!--
  KXS Watcher installer (WiX v4+). Built by build_msi.ps1:
    wix build wix\main.wxs -arch x64 -d Version=<x.y.z> -d ExePath=<release exe> -o <msi>
  Installs per user by default (no admin prompt): %LocalAppData%\Programs\KXS Watcher + a Start menu entry.
  Settings in %AppData%\KXS Watcher are left alone on uninstall.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- UpgradeCode must never change: it is how a new version finds and replaces the old one. -->
  <Package Name="KXS Watcher" Manufacturer="KXS Watcher" Version="$(var.Version)"
           UpgradeCode="9C52747C-913E-44D8-BF27-FEEE687C4435" Scope="perUserOrMachine">
    <!-- Same-version rebuilds replace each other too (handy while the version isn't bumped). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Unnamed10110/KXS_Watcher" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="KXS Watcher" />
    </StandardDirectory>

    <Feature Id="Main" Title="KXS Watcher">
      <Component Id="MainExe" Directory="INSTALLFOLDER">
        <File Id="KxsExe" Source="$(var.ExePath)" Name="kxs-watcher.exe" KeyPath="yes" />
      </Component>
      <!-- Shortcuts need their own component keyed on an HKCU value (ICE43 / ICE57). -->
      <Component Id="StartMenu" Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuShortcut" Name="KXS Watcher" Target="[#KxsExe]" WorkingDirectory="INSTALLFOLDER"
                  Description="Fast, lightweight Kubernetes / k3s manager" />
        <RegistryValue Root="HKCU" Key="Software\KXS Watcher" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
